# Optific+ environment (server-only). Copy to `.env.local` and fill in.
# `.env.local` is git-ignored. Never commit real values.

# Any OpenAI-compatible chat-completions endpoint.
# OpenCode Go: https://opencode.ai/zen/go/v1
# DeepSeek direct: https://api.deepseek.com/v1
LLM_BASE_URL=https://opencode.ai/zen/go/v1

# Your API key. Leave blank here; put the real value only in `.env.local`.
LLM_API_KEY=

# The model id served by the endpoint (for example deepseek-v4.1-flash, or deepseek-chat).
MODEL_NAME=

# Optional. Only needed by endpoints that require a routing session header
# (OpenCode Go uses x-opencode-session). Leave blank for other providers.
LLM_SESSION=

# Optional. Request timeout in milliseconds for one model call. Default 45000.
LLM_TIMEOUT_MS=

# Optional. USD per million tokens, used only to log an estimated cost per
# question. Nothing is hardcoded, so leave both blank and the logs show tokens
# without a cost estimate.
LLM_PRICE_INPUT_PER_M=
LLM_PRICE_OUTPUT_PER_M=
